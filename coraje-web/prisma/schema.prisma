generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["app", "core", "helpdesk"]
}

// =====================================================================
// CORE — datos maestros
// =====================================================================

// Catálogo cerrado de roles de aplicación (specs/permisos.md §4). PowerApps
// no tenía roles: el permiso salía de la relación con el ticket y de la lista
// RecibeHelpdesk (legacy/reglas-negocio-powerapps.md §6, §10). Aquí igual:
// qué área ve alguien lo decide el enrutamiento, no el rol (§4.5).
enum RolAplicacion {
  // Todo empleado con acceso (30-sep-2026; antes se llamaba AGENTE). Ve lo
  // que radicó, lo que le asignaron, lo que sigue y lo que recibe según el
  // enrutamiento.
  COLABORADOR
  // U8 (28-sep-2026): CLASIFICADOR clasifica los tickets del portal; ADMIN
  // administra los accesos de clientes y, desde el 30-sep-2026, consulta todos
  // los tickets. Ambos parten de una copia de las reglas de COLABORADOR.
  CLASIFICADOR
  ADMIN

  @@map("rol_aplicacion")
  @@schema("core")
}

model AreaExclusion {
  nombreAreaNormalizado String   @id @map("nombre_area_normalizado")
  motivo                String
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("area_exclusion")
  @@schema("core")
}

model ClienteContaiRecurso {
  idRecurso         String            @id @default(dbgenerated("gen_random_uuid()")) @map("id_recurso") @db.Uuid
  idClienteContai   String            @map("id_cliente_contai") @db.Uuid
  nombreRecurso     String?           @map("nombre_recurso") @db.VarChar(100)
  urlRecurso        String            @map("url_recurso")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  dimClienteContai  DimClienteContai  @relation(fields: [idClienteContai], references: [idClienteContai], onDelete: Cascade, onUpdate: NoAction)

  @@map("cliente_contai_recurso")
  @@schema("core")
}

model DimArea {
  idArea              String                   @id @default(dbgenerated("gen_random_uuid()")) @map("id_area") @db.Uuid
  spAreaId            Int?                     @unique @map("sp_area_id")
  nombreArea          String                   @unique @map("nombre_area") @db.VarChar(100)
  encargadoRecepcion  String?                  @map("encargado_recepcion") @db.VarChar(100)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  // NOT NULL confirmado contra la base real (10-sep-2026) — sql/db/04_core.sql la
  // declara nullable, pero la columna viva ya no lo es. La captura el baseline tal
  // como está hoy, no como dice el archivo committeado.
  codigoArea          String                   @unique @map("codigo_area") @db.VarChar(10)
  dimPersonal         DimPersonal[]
  dimTipoRequerimiento DimTipoRequerimiento[]
  factTicket          FactTicket[]
  ticketCodigoCounter TicketCodigoCounter[]

  @@map("dim_area")
  @@schema("core")
}

model DimClienteContai {
  idClienteContai        String                   @id @default(dbgenerated("gen_random_uuid()")) @map("id_cliente_contai") @db.Uuid
  spClienteId            Int?                     @unique @map("sp_cliente_id")
  identificacionFiscal   String?                  @map("identificacion_fiscal") @db.VarChar(50)
  nombreCliente          String                   @map("nombre_cliente") @db.VarChar(150)
  tipoCliente            String?                  @map("tipo_cliente") @db.VarChar(50)
  grupoEconomico         String?                  @map("grupo_economico") @db.VarChar(100)
  estadoCliente          Boolean                  @default(true) @map("estado_cliente")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  clienteContaiRecurso   ClienteContaiRecurso[]
  factTicket             FactTicket[]
  portalContacto         PortalContacto[]

  // Único parcial: NIT no vacío no se repite, pero permite múltiples clientes
  // sin identificación fiscal registrada (identificacion_fiscal IS NULL).
  @@unique([identificacionFiscal], map: "uq_dim_cliente_contai_identificacion_fiscal_not_null", where: raw("(identificacion_fiscal IS NOT NULL)"))
  @@map("dim_cliente_contai")
  @@schema("core")
}

model DimPersonal {
  idPersonal                             String               @id @default(dbgenerated("gen_random_uuid()")) @map("id_personal") @db.Uuid
  spPersonalId                           Int?                 @unique @map("sp_personal_id")
  spUserId                               Int?                 @unique @map("sp_user_id")
  cedula                                 String?              @db.VarChar(20)
  nombreCompleto                         String               @map("nombre_completo") @db.VarChar(200)
  correoCorporativo                      String?              @map("correo_corporativo") @db.VarChar(150)
  idArea                                 String?              @map("id_area") @db.Uuid
  cargo                                  String?              @db.VarChar(100)
  estadoActivo                           Boolean              @default(true) @map("estado_activo")
  createdAt                              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                              DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Modelo de buzón compartido (docs/specs/tickets.md §7.3, F10). Marca la fila
  // "responsable histórico no identificado" de un correo compartido por más de una
  // persona a lo largo del tiempo — nunca la persona que lo ocupa hoy.
  esResponsableHistoricoNoIdentificado   Boolean              @default(false) @map("es_responsable_historico_no_identificado")
  // --- Identidad de empleados (specs/acceso-empleados.md, U3) ---
  // Columnas propias de la plataforma, nunca tocadas por el UPSERT del ELT
  // (sql/elt/03_transform_personal.sql no las incluye en su SET) — mismo patrón
  // aditivo ya usado por F10 arriba. `rolAplicacion` nulo es la condición normal
  // de una fila recién llegada de SharePoint: la admisión la rechaza con
  // UNKNOWN_ROLE hasta que alguien la habilite a mano.
  rolAplicacion                          RolAplicacion?       @map("rol_aplicacion")
  // Sujeto inmutable del directorio de Entra ID (claim `oid` del id_token).
  // Se enlaza una sola vez, en el primer ingreso federado, y nunca se
  // sobrescribe desde una petición (specs/acceso-empleados.md §7, V4) — así una
  // cuenta renombrada o recreada en el tenant no puede capturar en silencio el
  // historial de otra persona.
  entraObjectId                          String?              @unique @map("entra_object_id") @db.VarChar(64)
  employeeSession                        EmployeeSession[]
  employeeGraphGrant                     EmployeeGraphGrant?
  notificacionesEnviadas                 TicketNotificacion[] @relation("NotificacionRemitente")
  notificacionesRecibidas                TicketNotificacion[] @relation("NotificacionDestinatario")
  dimArea                                DimArea?             @relation(fields: [idArea], references: [idArea], onDelete: NoAction, onUpdate: NoAction)
  factTicketAsignado                     FactTicket[]         @relation("FactTicketAsignado")
  factTicketSolicitante                  FactTicket[]         @relation("FactTicketSolicitante")
  factTicketEvento                       FactTicketEvento[]
  portalContactosCreados                 PortalContacto[]     @relation("PortalContactoCreadoPor")
  portalAccesosConcedidos                PortalAutorizacion[] @relation("PortalAutorizacionConcedidaPor")
  portalAccesosRevocados                 PortalAutorizacion[] @relation("PortalAutorizacionRevocadaPor")
  portalInvitacionesEmitidas             PortalInvitacion[]
  portalAuditoria                        PortalAuditoria[]
  divergenciasRevisadas                  SyncDivergencia[]
  ticketsObservados                      TicketObservador[]   @relation("ObservadorPersona")
  observadoresAgregados                  TicketObservador[]   @relation("ObservadorAgregadoPor")
  validacionesRecibidas                  TicketValidacion[]
  // SUPLANTACIÓN — bloque temporal para pruebas.
  suplantacionHabilitada                 SuplantacionHabilitada? @relation("SuplantacionHabilitada")
  suplantacionesComoDestino              SuplantacionActiva[]    @relation("SuplantacionActivaPersona")
  suplantacionAuditoriaReal              SuplantacionAuditoria[] @relation("SuplantacionAuditoriaReal")
  suplantacionAuditoriaSuplantado        SuplantacionAuditoria[] @relation("SuplantacionAuditoriaSuplantado")
  // FIN SUPLANTACIÓN

  // Como máximo un marcador histórico por correo compartido — protege la regla
  // dura de F10: nunca atribuir historial a quien ocupa el buzón hoy.
  @@unique([correoCorporativo], map: "ux_dim_personal_correo_historico", where: raw("es_responsable_historico_no_identificado"))
  // Búsqueda determinista por correo en el primer ingreso federado (bootstrap
  // antes de que exista el enlace por entraObjectId): a lo sumo una fila activa,
  // no marcada como buzón histórico, por correo corporativo. specs/acceso-empleados.md
  // §7.1 señalaba este hueco; este índice es lo que lo cierra.
  @@unique([correoCorporativo], map: "ux_dim_personal_correo_activo", where: raw("estado_activo AND NOT es_responsable_historico_no_identificado"))
  @@map("dim_personal")
  @@schema("core")
}

// =====================================================================
// APP — estado propio de la plataforma (ni dato migrado de SharePoint, ni
// dominio de tickets). Schema separado de `core`/`helpdesk` a propósito: la
// sesión de un empleado no es un dato maestro ni un hecho de negocio.
// =====================================================================

/// specs/acceso-empleados.md §6: el navegador guarda solo una credencial opaca
/// aleatoria; esta tabla guarda su hash (nunca el valor plano), a quién
/// pertenece, qué proveedor afirmó la identidad y cuándo muere. Única función
/// que crea filas aquí: issueEmployeeSession (src/server/auth/employee-session.ts).
model EmployeeSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idPersonal       String    @map("id_personal") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.VarChar(64)
  identitySubject  String    @map("identity_subject") @db.VarChar(255)
  identityTenantId String    @map("identity_tenant_id") @db.VarChar(64)
  issuedAt         DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  // Actualizado con throttle (specs/acceso-empleados.md §6): renderizar una
  // página no debe costar una escritura en cada petición.
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  // Vida absoluta de 8h, sin renovación deslizante — una sesión que se renueva
  // sola no vence nunca.
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason") @db.VarChar(200)
  userAgent        String?   @map("user_agent") @db.VarChar(400)
  dimPersonal      DimPersonal @relation(fields: [idPersonal], references: [idPersonal], onDelete: Cascade, onUpdate: NoAction)
  // SUPLANTACIÓN — bloque temporal para pruebas.
  suplantacion     SuplantacionActiva?
  // FIN SUPLANTACIÓN

  @@index([idPersonal, expiresAt], map: "ix_employee_session_personal_expires")
  @@index([expiresAt], map: "ix_employee_session_expires")
  @@map("employee_session")
  @@schema("app")
}

/// Autorización delegada de Microsoft Graph de un empleado (D6,
/// specs/acceso-empleados.md §9): el refresh_token del ingreso, sellado con
/// AES-256-GCM (secret-box.ts). Única función que escribe filas nuevas:
/// recordGraphGrant (src/server/auth/graph-grant.ts), desde el callback de
/// ingreso. Cerrar sesión no la borra.
model EmployeeGraphGrant {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idPersonal         String      @unique @map("id_personal") @db.Uuid
  refreshTokenSealed String      @map("refresh_token_sealed")
  grantedScope       String      @map("granted_scope") @db.VarChar(1000)
  identityTenantId   String      @map("identity_tenant_id") @db.VarChar(64)
  identitySubject    String      @map("identity_subject") @db.VarChar(255)
  obtainedAt         DateTime    @default(now()) @map("obtained_at") @db.Timestamptz(6)
  lastRefreshedAt    DateTime?   @map("last_refreshed_at") @db.Timestamptz(6)
  // invalid_grant de Entra: la autorización murió y solo un nuevo ingreso la revive.
  revokedAt          DateTime?   @map("revoked_at") @db.Timestamptz(6)
  revokedReason      String?     @map("revoked_reason") @db.VarChar(300)
  dimPersonal        DimPersonal @relation(fields: [idPersonal], references: [idPersonal], onDelete: Cascade, onUpdate: NoAction)

  @@map("employee_graph_grant")
  @@schema("app")
}

// SUPLANTACIÓN — bloque temporal para pruebas. Ver
// src/server/auth/suplantacion.ts y docs/estado/operacion.md.

/// Quién puede trabajar como otro empleado. Se inserta a mano por psql; la
/// aplicación solo la lee (SELECT para coraje_runtime).
model SuplantacionHabilitada {
  idPersonal   String      @id @map("id_personal") @db.Uuid
  habilitadaAt DateTime    @default(now()) @map("habilitada_at") @db.Timestamptz(6)
  nota         String?     @db.VarChar(200)
  dimPersonal  DimPersonal @relation("SuplantacionHabilitada", fields: [idPersonal], references: [idPersonal], onDelete: Cascade, onUpdate: NoAction)

  @@map("suplantacion_habilitada")
  @@schema("app")
}

/// A quién mira cada sesión mientras suplanta. Muere con la sesión.
model SuplantacionActiva {
  idSesion             String          @id @map("id_sesion") @db.Uuid
  idPersonalSuplantado String          @map("id_personal_suplantado") @db.Uuid
  iniciadaAt           DateTime        @default(now()) @map("iniciada_at") @db.Timestamptz(6)
  sesion               EmployeeSession @relation(fields: [idSesion], references: [id], onDelete: Cascade, onUpdate: NoAction)
  suplantado           DimPersonal     @relation("SuplantacionActivaPersona", fields: [idPersonalSuplantado], references: [idPersonal], onDelete: Cascade, onUpdate: NoAction)

  @@map("suplantacion_activa")
  @@schema("app")
}

/// Cada cambio de persona, incluido el regreso a uno mismo (suplantado nulo).
/// Solo crece (SELECT e INSERT para coraje_runtime).
model SuplantacionAuditoria {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idSesion             String       @map("id_sesion") @db.Uuid
  idPersonalReal       String       @map("id_personal_real") @db.Uuid
  idPersonalSuplantado String?      @map("id_personal_suplantado") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  real                 DimPersonal  @relation("SuplantacionAuditoriaReal", fields: [idPersonalReal], references: [idPersonal], onDelete: Restrict, onUpdate: NoAction)
  suplantado           DimPersonal? @relation("SuplantacionAuditoriaSuplantado", fields: [idPersonalSuplantado], references: [idPersonal], onDelete: Restrict, onUpdate: NoAction)

  @@index([idPersonalReal, createdAt], map: "ix_suplantacion_auditoria_real")
  @@map("suplantacion_auditoria")
  @@schema("app")
}

// FIN SUPLANTACIÓN

/// Sobre qué tickets vale una regla (specs/permisos.md §4). Su significado
/// exacto por acción vive en un solo sitio: src/server/authorization/scope.ts.
enum AlcancePermiso {
  PROPIO
  AREA
  TOTAL

  @@map("alcance_permiso")
  @@schema("app")
}

/// Catálogo de acciones (specs/permisos.md §3). PostgreSQL es la única fuente
/// operativa: el código consulta la regla y nunca compara roles. Se siembra y
/// se cambia por migración; coraje_runtime solo tiene SELECT.
model PermisoAccion {
  codigo      String         @id @db.VarChar(80)
  nombre      String         @db.VarChar(150)
  descripcion String
  activo      Boolean        @default(true)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  reglas      PermisoRegla[]

  @@map("permiso_accion")
  @@schema("app")
}

/// Una fila por rol y acción. Sin fila, la acción está denegada para ese rol.
model PermisoRegla {
  rol          RolAplicacion
  codigoAccion String         @map("codigo_accion") @db.VarChar(80)
  alcance      AlcancePermiso
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  accion       PermisoAccion  @relation(fields: [codigoAccion], references: [codigo], onDelete: Restrict, onUpdate: NoAction)

  @@id([rol, codigoAccion])
  @@map("permiso_regla")
  @@schema("app")
}

// ---------------------------------------------------------------------
// Acceso externo de clientes (specs/acceso-clientes.md, U8). Migración
// 20260928110000_acceso_clientes, que documenta cada CHECK no representable.
// Ningún token, código ni credencial se guarda en claro: solo su hash.
// ---------------------------------------------------------------------

/// Una persona de un cliente con acceso al portal. Pertenece a un solo
/// cliente y ve solo los tickets que ella radicó (D2).
model PortalContacto {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idClienteContai  String                 @map("id_cliente_contai") @db.Uuid
  nombre           String                 @db.VarChar(200)
  activo           Boolean                @default(true)
  creadoPor        String                 @map("creado_por") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  dimClienteContai DimClienteContai       @relation(fields: [idClienteContai], references: [idClienteContai], onDelete: Restrict, onUpdate: NoAction)
  creador          DimPersonal            @relation("PortalContactoCreadoPor", fields: [creadoPor], references: [idPersonal], onDelete: NoAction, onUpdate: NoAction)
  correos          PortalContactoCorreo[]
  autorizaciones   PortalAutorizacion[]
  auditoria        PortalAuditoria[]
  factTicket       FactTicket[]
  eventosAutor     FactTicketEvento[]
  notificaciones   TicketNotificacion[]

  @@index([idClienteContai], map: "ix_portal_contacto_cliente")
  @@map("portal_contacto")
  @@schema("app")
}

/// Correos de un contacto, todos de igual valor (no hay correo principal).
/// Se guardan normalizados: chk_portal_contacto_correo_normalizado.
model PortalContactoCorreo {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idContacto String             @map("id_contacto") @db.Uuid
  correo     String             @db.VarChar(254)
  activo     Boolean            @default(true)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  contacto   PortalContacto     @relation(fields: [idContacto], references: [id], onDelete: Restrict, onUpdate: NoAction)
  desafios   PortalDesafioOtp[]

  // Un correo activo identifica a lo sumo a un contacto: el ingreso por
  // código tiene una sola respuesta a «¿a quién se lo mando?».
  @@unique([correo], map: "ux_portal_contacto_correo_activo", where: raw("activo"))
  @@index([idContacto], map: "ix_portal_contacto_correo_contacto")
  @@map("portal_contacto_correo")
  @@schema("app")
}

/// Concesión de acceso de un contacto. Una sola ACTIVA por contacto. El guard
/// exige `activadaAt` además de un dispositivo válido (B2 de Impulsa, cerrada
/// desde el principio). CHECK: estado IN (ACTIVA, REVOCADA), y revocadaAt
/// presente si y solo si REVOCADA.
model PortalAutorizacion {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idContacto       String              @map("id_contacto") @db.Uuid
  estado           String              @default("ACTIVA") @db.VarChar(20)
  soloLectura      Boolean             @default(false) @map("solo_lectura")
  activadaAt       DateTime?           @map("activada_at") @db.Timestamptz(6)
  concedidaPor     String              @map("concedida_por") @db.Uuid
  revocadaAt       DateTime?           @map("revocada_at") @db.Timestamptz(6)
  revocadaPor      String?             @map("revocada_por") @db.Uuid
  motivoRevocacion String?             @map("motivo_revocacion") @db.VarChar(500)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  contacto         PortalContacto      @relation(fields: [idContacto], references: [id], onDelete: Restrict, onUpdate: NoAction)
  concedente       DimPersonal         @relation("PortalAutorizacionConcedidaPor", fields: [concedidaPor], references: [idPersonal], onDelete: NoAction, onUpdate: NoAction)
  revocador        DimPersonal?        @relation("PortalAutorizacionRevocadaPor", fields: [revocadaPor], references: [idPersonal], onDelete: NoAction, onUpdate: NoAction)
  invitaciones     PortalInvitacion[]
  desafios         PortalDesafioOtp[]
  dispositivos     PortalDispositivo[]
  auditoria        PortalAuditoria[]

  @@unique([idContacto], map: "ux_portal_autorizacion_activa", where: raw("estado = 'ACTIVA'"))
  @@map("portal_autorizacion")
  @@schema("app")
}

/// Invitación de un solo uso. Solo el hash del enlace. CHECK: estado IN
/// (PENDIENTE, CONSUMIDA, REEMPLAZADA, REVOCADA), consumidaAt si y solo si
/// CONSUMIDA. A lo sumo una PENDIENTE por autorización.
model PortalInvitacion {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idAutorizacion String             @map("id_autorizacion") @db.Uuid
  tokenHash      String             @unique(map: "ux_portal_invitacion_token_hash") @map("token_hash") @db.Char(64)
  estado         String             @default("PENDIENTE") @db.VarChar(20)
  expiraAt       DateTime           @map("expira_at") @db.Timestamptz(6)
  consumidaAt    DateTime?          @map("consumida_at") @db.Timestamptz(6)
  emitidaPor     String             @map("emitida_por") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  autorizacion   PortalAutorizacion @relation(fields: [idAutorizacion], references: [id], onDelete: Restrict, onUpdate: NoAction)
  emisor         DimPersonal        @relation(fields: [emitidaPor], references: [idPersonal], onDelete: NoAction, onUpdate: NoAction)

  @@unique([idAutorizacion], map: "ux_portal_invitacion_pendiente", where: raw("estado = 'PENDIENTE'"))
  @@map("portal_invitacion")
  @@schema("app")
}

/// Código de seis dígitos para un navegador nuevo. `codeHash` es un HMAC con
/// clave del servidor. CHECK: estado IN (ACTIVO, VERIFICADO, REEMPLAZADO,
/// VENCIDO, AGOTADO) y 0 <= intentos <= maxIntentos.
model PortalDesafioOtp {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idAutorizacion String               @map("id_autorizacion") @db.Uuid
  idCorreo       String               @map("id_correo") @db.Uuid
  codeHash       String               @map("code_hash") @db.Char(64)
  estado         String               @default("ACTIVO") @db.VarChar(20)
  intentos       Int                  @default(0)
  maxIntentos    Int                  @map("max_intentos")
  expiraAt       DateTime             @map("expira_at") @db.Timestamptz(6)
  verificadoAt   DateTime?            @map("verificado_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  autorizacion   PortalAutorizacion   @relation(fields: [idAutorizacion], references: [id], onDelete: Restrict, onUpdate: NoAction)
  correo         PortalContactoCorreo @relation(fields: [idCorreo], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([idAutorizacion, createdAt], map: "ix_portal_desafio_otp_autorizacion")
  @@map("portal_desafio_otp")
  @@schema("app")
}

/// Navegador recordado. Cuelga de la autorización, no del contacto. Sin
/// vencimiento absoluto (D3): `ultimoUsoAt` alimenta la regla de 180 días de
/// inactividad. CHECK: estado IN (ACTIVO, REVOCADO), revocadoAt si y solo si
/// REVOCADO.
model PortalDispositivo {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idAutorizacion String             @map("id_autorizacion") @db.Uuid
  credentialHash String             @unique(map: "ux_portal_dispositivo_credential_hash") @map("credential_hash") @db.Char(64)
  estado         String             @default("ACTIVO") @db.VarChar(20)
  ultimoUsoAt    DateTime           @default(now()) @map("ultimo_uso_at") @db.Timestamptz(6)
  revocadoAt     DateTime?          @map("revocado_at") @db.Timestamptz(6)
  userAgent      String?            @map("user_agent") @db.VarChar(400)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  autorizacion   PortalAutorizacion @relation(fields: [idAutorizacion], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([idAutorizacion], map: "ix_portal_dispositivo_autorizacion")
  @@map("portal_dispositivo")
  @@schema("app")
}

/// Auditoría del acceso externo: solo INSERT para coraje_runtime. Nunca lleva
/// el código ni el enlace. CHECK: resultado IN (EXITO, FALLO).
model PortalAuditoria {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evento         String              @db.VarChar(60)
  resultado      String              @db.VarChar(20)
  idContacto     String?             @map("id_contacto") @db.Uuid
  idAutorizacion String?             @map("id_autorizacion") @db.Uuid
  idPersonal     String?             @map("id_personal") @db.Uuid
  motivo         String?             @db.VarChar(500)
  metadata       Json                @default("{}")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  contacto       PortalContacto?     @relation(fields: [idContacto], references: [id], onDelete: Restrict, onUpdate: NoAction)
  autorizacion   PortalAutorizacion? @relation(fields: [idAutorizacion], references: [id], onDelete: Restrict, onUpdate: NoAction)
  dimPersonal    DimPersonal?        @relation(fields: [idPersonal], references: [idPersonal], onDelete: NoAction, onUpdate: NoAction)

  @@index([idContacto, createdAt], map: "ix_portal_auditoria_contacto")
  @@index([idAutorizacion, createdAt], map: "ix_portal_auditoria_autorizacion")
  // U10: envíos fallidos del portal, lo que busca la revisión de salud (S7).
  @@index([createdAt], map: "ix_portal_auditoria_fallo", where: raw("((resultado)::text = 'FALLO'::text)"))
  @@map("portal_auditoria")
  @@schema("app")
}

// =====================================================================
// HELPDESK — dimensiones, hechos y reglas
// =====================================================================

/// Catálogo de estados. v1: ABIERTO, ASIGNADO, CERRADO, RECHAZADO
/// (docs/specs/tickets.md §4). Un estado nuevo es un INSERT más sus
/// transiciones en helpdesk.registrar_evento_ticket.
model DimEstado {
  idEstado      String        @id @default(dbgenerated("gen_random_uuid()")) @map("id_estado") @db.Uuid
  nombreEstado  String        @unique @map("nombre_estado") @db.VarChar(50)
  factTicket    FactTicket[]
  eventosDesde  FactTicketEvento[] @relation("EventoEstadoAnterior")
  eventosHacia  FactTicketEvento[] @relation("EventoEstadoNuevo")

  @@map("dim_estado")
  @@schema("helpdesk")
}

// Vocabularios cerrados del evento del ticket (docs/specs/tickets.md §6).
// Un valor nuevo va con ALTER TYPE ... ADD VALUE en su propio archivo de
// migración, y un tipo de evento nuevo exige además su rama en
// helpdesk.registrar_evento_ticket: sin ella, la función falla con
// CASE_NOT_FOUND al recibirlo.
enum TipoEventoTicket {
  CREACION
  REDIRECCION
  REASIGNACION
  RESPUESTA
  RECHAZO
  COMENTARIO
  MIGRACION_LEGACY
  SINCRONIZACION_LEGACY
  // U11 (tickets.md §11): seguimiento del ticket. Ninguno cambia el estado.
  OBSERVADOR_AGREGADO
  OBSERVADOR_RETIRADO
  SOLICITUD_VALIDACION
  COMENTARIO_SOLICITANTE

  @@map("tipo_evento_ticket")
  @@schema("helpdesk")
}

enum TipoActorEvento {
  EMPLEADO
  SISTEMA
  // U8: el contacto de un cliente que radica su ticket (T1). Su columna es
  // idContactoAutor, atada al tipo por chk_fact_ticket_evento_actor.
  CLIENTE

  @@map("tipo_actor_evento")
  @@schema("helpdesk")
}

enum VisibilidadEvento {
  INTERNO
  CLIENTE
  AMBOS

  @@map("visibilidad_evento")
  @@schema("helpdesk")
}

/// dias_sla > 0, peso_prioridad >= 1 — CHECK no representable en el DSL de Prisma.
/// Preservado a mano en la migración baseline; ver disciplina de migrate en
/// docs/estado/operacion.md antes de correr `migrate dev` sobre esta tabla.
model DimPrioridad {
  idPrioridad     String        @id @default(dbgenerated("gen_random_uuid()")) @map("id_prioridad") @db.Uuid
  nombrePrioridad String        @unique @map("nombre_prioridad") @db.VarChar(50)
  diasSla         Int           @map("dias_sla")
  pesoPrioridad   Int           @map("peso_prioridad")
  factTicket      FactTicket[]

  @@map("dim_prioridad")
  @@schema("helpdesk")
}

model DimTipoRequerimiento {
  idTipoReq             String        @id @default(dbgenerated("gen_random_uuid()")) @map("id_tipo_req") @db.Uuid
  spTipoReqId           Int?          @unique @map("sp_tipo_req_id")
  idArea                String        @map("id_area") @db.Uuid
  tipoRequerimiento     String        @map("tipo_requerimiento") @db.VarChar(150)
  categoria1            String?       @map("categoria_1") @db.VarChar(150)
  categoria2            String?       @map("categoria_2") @db.VarChar(150)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  dimArea               DimArea       @relation(fields: [idArea], references: [idArea], onDelete: NoAction, onUpdate: NoAction)
  factTicket            FactTicket[]  @relation("FactTicketTipoReq")
  factTicketAreaDestino FactTicket[]  @relation("FactTicketTipoReqArea")
  routingRule           RoutingRule?

  @@unique([idArea, tipoRequerimiento, categoria1, categoria2], map: "uq_dim_tipo_req_natural")
  @@unique([idTipoReq, idArea], map: "uq_dim_tipo_requerimiento_id_tipo_req_id_area")
  @@map("dim_tipo_requerimiento")
  @@schema("helpdesk")
}

/// CHECK no representables (chk_fact_ticket_calificacion, _fechas_validas,
/// _origen_exclusivo, _origen_sistema) y el trigger trg_set_codigo_ticket, que
/// completa `codigoTicket` antes de INSERT o de UPDATE de `idAreaDestino` — ambos
/// preservados a mano en la migración baseline, ninguno representable en el DSL.
model FactTicket {
  idTicket             String                  @id @default(dbgenerated("gen_random_uuid()")) @map("id_ticket") @db.Uuid
  // Nullable en la base real (sql/db/ lo declara NOT NULL): un ticket de portal
  // nace sin área y el trigger no genera código hasta que la tiene.
  codigoTicket         String?                 @unique @map("codigo_ticket")
  descripcionProblema  String                  @map("descripcion_problema")
  idClienteContai      String?                 @map("id_cliente_contai") @db.Uuid
  idSolicitante        String?                 @map("id_solicitante") @db.Uuid
  idAreaDestino        String?                 @map("id_area_destino") @db.Uuid
  idAsignado           String?                 @map("id_asignado") @db.Uuid
  idEstado             String                  @map("id_estado") @db.Uuid
  idPrioridad          String?                 @map("id_prioridad") @db.Uuid
  idTipoReq            String?                 @map("id_tipo_req") @db.Uuid
  fechaCreacion        DateTime                @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaLimite          DateTime?               @map("fecha_limite") @db.Timestamptz(6)
  fechaResolucion      DateTime?               @map("fecha_resolucion") @db.Timestamptz(6)
  respuestaFinal       String?                 @map("respuesta_final")
  calificacion         Int?
  origenSistema        String                  @map("origen_sistema")
  ultimaActualizacion  DateTime                @default(now()) @map("ultima_actualizacion") @db.Timestamptz(6)
  encargadoInterno     String?                 @map("encargado_interno")
  // U8 (D2): el contacto que radicó un ticket del portal. Lo escribe solo
  // helpdesk.crear_ticket_cliente; coraje_runtime no tiene UPDATE sobre la
  // columna. chk_fact_ticket_origen_portal: presente si y solo si
  // origen_sistema = PORTAL_CLIENTE.
  idContactoPortal     String?                 @map("id_contacto_portal") @db.Uuid
  portalContacto       PortalContacto?         @relation(fields: [idContactoPortal], references: [id], onDelete: Restrict, onUpdate: NoAction)
  dimArea              DimArea?                @relation(fields: [idAreaDestino], references: [idArea], onDelete: NoAction, onUpdate: NoAction)
  dimPersonalAsignado  DimPersonal?            @relation("FactTicketAsignado", fields: [idAsignado], references: [idPersonal], onDelete: NoAction, onUpdate: NoAction)
  dimClienteContai     DimClienteContai?       @relation(fields: [idClienteContai], references: [idClienteContai], onDelete: NoAction, onUpdate: NoAction)
  dimEstado            DimEstado               @relation(fields: [idEstado], references: [idEstado], onDelete: NoAction, onUpdate: NoAction)
  dimPrioridad         DimPrioridad?           @relation(fields: [idPrioridad], references: [idPrioridad], onDelete: NoAction, onUpdate: NoAction)
  dimPersonalSolicitante DimPersonal?          @relation("FactTicketSolicitante", fields: [idSolicitante], references: [idPersonal], onDelete: NoAction, onUpdate: NoAction)
  dimTipoRequerimiento DimTipoRequerimiento?   @relation("FactTicketTipoReq", fields: [idTipoReq], references: [idTipoReq], onDelete: NoAction, onUpdate: NoAction)
  dimTipoRequerimientoArea DimTipoRequerimiento? @relation("FactTicketTipoReqArea", fields: [idTipoReq, idAreaDestino], references: [idTipoReq, idArea], onDelete: NoAction, onUpdate: NoAction, map: "fk_fact_ticket_tipo_req_area")
  factTicketEvento     FactTicketEvento[]
  ticketLegacySharepointRef TicketLegacySharepointRef?
  ticketSyncOutbox     TicketSyncOutbox[]
  ticketNotificacion   TicketNotificacion[]
  syncDivergencia      SyncDivergencia[]
  observadores         TicketObservador[]
  validaciones         TicketValidacion[]

  // Sin índices sobre las FK (id_cliente_contai, id_solicitante, id_area_destino,
  // id_asignado, id_estado, id_prioridad, id_tipo_req): sql/db/06_helpdesk_facts.sql
  // los declara, pero ninguno existe contra la base real (confirmado 10-sep-2026) —
  // el baseline captura la realidad, no el archivo. Brecha de rendimiento real sobre
  // 2.825+ filas, sin resolver: no es parte del alcance de esta unidad.
  @@map("fact_ticket")
  @@schema("helpdesk")
}

/// Registro de eventos del ticket: solo INSERT, y solo a través de
/// helpdesk.registrar_evento_ticket (docs/specs/tickets.md §3, §3.1). Nunca
/// escribir esta tabla con el cliente de Prisma: el escritor único valida la
/// transición y escribe la proyección en fact_ticket en la misma transacción.
/// Se llama con $queryRaw dentro de la transacción de la acción.
///
/// No representable en el DSL: chk_fact_ticket_evento_actor (EMPLEADO exige
/// idAutor, SISTEMA lo exige vacío). coraje_runtime y coraje_etl no tienen
/// INSERT, UPDATE ni DELETE sobre esta tabla (migración
/// 20260925180000_proteger_estado_y_eventos): un intento directo falla con
/// permission denied.
model FactTicketEvento {
  idEvento          String            @id @default(dbgenerated("gen_random_uuid()")) @map("id_evento") @db.Uuid
  spEventId         Int?              @unique @map("sp_event_id")
  eventHash         String?           @unique @map("event_hash")
  idTicket          String            @map("id_ticket") @db.Uuid
  idAutor           String?           @map("id_autor") @db.Uuid
  // U8: autor cuando tipoActor = CLIENTE (chk_fact_ticket_evento_actor).
  idContactoAutor   String?           @map("id_contacto_autor") @db.Uuid
  tipoEvento        TipoEventoTicket  @map("tipo_evento")
  tipoActor         TipoActorEvento   @map("tipo_actor")
  visibilidad       VisibilidadEvento
  idEstadoAnterior  String?           @map("id_estado_anterior") @db.Uuid
  idEstadoNuevo     String?           @map("id_estado_nuevo") @db.Uuid
  contenido         String
  fechaRegistro     DateTime          @default(now()) @map("fecha_registro") @db.Timestamptz(6)
  dimPersonal       DimPersonal?      @relation(fields: [idAutor], references: [idPersonal], onDelete: NoAction, onUpdate: NoAction)
  contactoAutor     PortalContacto?   @relation(fields: [idContactoAutor], references: [id], onDelete: Restrict, onUpdate: NoAction)
  factTicket        FactTicket        @relation(fields: [idTicket], references: [idTicket], onDelete: Restrict, onUpdate: NoAction)
  estadoAnterior    DimEstado?        @relation("EventoEstadoAnterior", fields: [idEstadoAnterior], references: [idEstado], onDelete: NoAction, onUpdate: NoAction)
  estadoNuevo       DimEstado?        @relation("EventoEstadoNuevo", fields: [idEstadoNuevo], references: [idEstado], onDelete: NoAction, onUpdate: NoAction)
  ticketNotificacion TicketNotificacion[]
  ticketValidacion  TicketValidacion?

  @@index([idTicket, fechaRegistro], map: "ix_fact_ticket_evento_ticket_fecha")
  @@map("fact_ticket_evento")
  @@schema("helpdesk")
}

/// Personas que siguen un ticket sin atenderlo (tickets.md §11, U11). Estado
/// vigente, no historia: quién añadió y quién retiró a cada una está en los
/// eventos OBSERVADOR_AGREGADO / OBSERVADOR_RETIRADO, escritos en la misma
/// transacción que la fila. coraje_runtime tiene SELECT, INSERT y DELETE,
/// nunca UPDATE (migración 20260928150000_seguimiento_ticket).
model TicketObservador {
  idTicket    String      @map("id_ticket") @db.Uuid
  idPersonal  String      @map("id_personal") @db.Uuid
  agregadoPor String      @map("agregado_por") @db.Uuid
  agregadoAt  DateTime    @default(now()) @map("agregado_at") @db.Timestamptz(6)
  factTicket  FactTicket  @relation(fields: [idTicket], references: [idTicket], onDelete: Restrict, onUpdate: NoAction)
  persona     DimPersonal @relation("ObservadorPersona", fields: [idPersonal], references: [idPersonal], onDelete: Restrict, onUpdate: NoAction)
  agregador   DimPersonal @relation("ObservadorAgregadoPor", fields: [agregadoPor], references: [idPersonal], onDelete: NoAction, onUpdate: NoAction)

  @@id([idTicket, idPersonal])
  @@index([idPersonal], map: "ix_ticket_observador_persona")
  @@map("ticket_observador")
  @@schema("helpdesk")
}

/// A quién se dirigió cada solicitud de validación (U11). Una fila por evento
/// SOLICITUD_VALIDACION; solo crece (SELECT e INSERT para coraje_runtime).
model TicketValidacion {
  idEvento       String           @id @map("id_evento") @db.Uuid
  idTicket       String           @map("id_ticket") @db.Uuid
  idDestinatario String           @map("id_destinatario") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  evento         FactTicketEvento @relation(fields: [idEvento], references: [idEvento], onDelete: Restrict, onUpdate: NoAction)
  factTicket     FactTicket       @relation(fields: [idTicket], references: [idTicket], onDelete: Restrict, onUpdate: NoAction)
  destinatario   DimPersonal      @relation(fields: [idDestinatario], references: [idPersonal], onDelete: Restrict, onUpdate: NoAction)

  @@index([idDestinatario, createdAt(sort: Desc)], map: "ix_ticket_validacion_destinatario")
  @@map("ticket_validacion")
  @@schema("helpdesk")
}

model RoutingRule {
  idRoutingRule         String                @id @default(dbgenerated("gen_random_uuid()")) @map("id_routing_rule") @db.Uuid
  idTipoReq             String                @unique(map: "uq_routing_rule_tipo_req") @map("id_tipo_req") @db.Uuid
  encargadoInterno      String                @map("encargado_interno")
  descripcion           String?
  activo                Boolean               @default(true)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  dimTipoRequerimiento  DimTipoRequerimiento  @relation(fields: [idTipoReq], references: [idTipoReq], onDelete: Cascade, onUpdate: NoAction)

  @@index([activo], map: "ix_routing_rule_activo")
  @@index([idTipoReq], map: "ix_routing_rule_tipo_req")
  @@map("routing_rule")
  @@schema("helpdesk")
}

/// chk_ticket_codigo_counter_anio (anio >= 2000), _last_number (last_number >= 0) —
/// no representables, preservados a mano en la migración baseline.
///
/// Tabla no documentada en ningún sql/db/*.sql hasta esta unidad (F12,
/// docs/estado/handoff.md corte 5): sostiene el trigger trg_set_codigo_ticket, que
/// genera codigo_ticket como "{codigo_area}-{año real}-{consecutivo de 4 dígitos}",
/// un consecutivo por área y año. Confirmado activo y correcto contra la base real.
model TicketCodigoCounter {
  idArea      String    @map("id_area") @db.Uuid
  anio        Int
  lastNumber  Int       @default(0) @map("last_number")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  dimArea     DimArea   @relation(fields: [idArea], references: [idArea], onDelete: NoAction, onUpdate: NoAction)

  @@id([idArea, anio])
  @@map("ticket_codigo_counter")
  @@schema("helpdesk")
}

model TicketLegacySharepointRef {
  idTicket         String      @id @map("id_ticket") @db.Uuid
  spId             Int         @unique @map("sp_id")
  legacyIdReq      String?     @map("legacy_id_req")
  legacyTitle      String?     @map("legacy_title")
  legacyCreatedAt  DateTime?   @map("legacy_created_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  // U9: el ítem de SharePoint tal como se vio tras la última escritura de
  // HelpDesk o la última conciliación. Distingue el eco de un cambio hecho en
  // PowerApps (migración 20260928120000_espejo_sharepoint).
  espejoConciliado   Json?     @map("espejo_conciliado")
  espejoConciliadoAt DateTime? @map("espejo_conciliado_at") @db.Timestamptz(6)
  factTicket       FactTicket  @relation(fields: [idTicket], references: [idTicket], onDelete: Cascade, onUpdate: NoAction, map: "fk_ticket_legacy_sharepoint_ref_ticket")

  // ix_ticket_legacy_sharepoint_ref_legacy_id_req / _legacy_created_at: declarados
  // en sql/db/06_helpdesk_facts.sql, sin existir contra la base real (10-sep-2026) —
  // mismo patrón que fact_ticket. El baseline no los recrea.
  @@map("ticket_legacy_sharepoint_ref")
  @@schema("helpdesk")
}

/// Un correo producido por una acción del ticket (D6). Nace PENDIENTE en la
/// transacción del evento y se envía después del commit, sin worker
/// (src/server/notifications/ticket-notifications.ts). CHECK no representables:
/// chk_ticket_notificacion_estado (PENDIENTE, ENVIANDO, ENVIADO, FALLIDO),
/// _intentos (>= 0) y _destinatario (un empleado o un contacto, exactamente
/// uno, U8). coraje_runtime no tiene DELETE: lo enviado es evidencia.
model TicketNotificacion {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idTicket           String           @map("id_ticket") @db.Uuid
  idEvento           String           @map("id_evento") @db.Uuid
  idRemitente        String           @map("id_remitente") @db.Uuid
  idDestinatario     String?          @map("id_destinatario") @db.Uuid
  idContactoDestinatario String?      @map("id_contacto_destinatario") @db.Uuid
  destinatarioCorreo String           @map("destinatario_correo") @db.VarChar(150)
  asunto             String           @db.VarChar(300)
  cuerpoHtml         String           @map("cuerpo_html")
  estado             String           @default("PENDIENTE") @db.VarChar(20)
  intentos           Int              @default(0)
  ultimoError        String?          @map("ultimo_error") @db.VarChar(1000)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  enviadoAt          DateTime?        @map("enviado_at") @db.Timestamptz(6)
  factTicket         FactTicket       @relation(fields: [idTicket], references: [idTicket], onDelete: Restrict, onUpdate: NoAction)
  factTicketEvento   FactTicketEvento @relation(fields: [idEvento], references: [idEvento], onDelete: Restrict, onUpdate: NoAction)
  remitente          DimPersonal      @relation("NotificacionRemitente", fields: [idRemitente], references: [idPersonal], onDelete: NoAction, onUpdate: NoAction)
  destinatario       DimPersonal?     @relation("NotificacionDestinatario", fields: [idDestinatario], references: [idPersonal], onDelete: NoAction, onUpdate: NoAction)
  contactoDestinatario PortalContacto? @relation(fields: [idContactoDestinatario], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([idTicket, createdAt], map: "ix_ticket_notificacion_ticket")
  // U10: lo que busca la revisión de salud (S5). Casi vacío en una base sana.
  @@index([updatedAt], map: "ix_ticket_notificacion_no_enviada", where: raw("((estado)::text <> 'ENVIADO'::text)"))
  @@map("ticket_notificacion")
  @@schema("helpdesk")
}

/// CHECK no representables (chk_ticket_sync_outbox_target/_operation/_status/
/// _attempts) preservados a mano en la migración baseline. Patrón bueno, no se
/// rediseña (docs/estado/handoff.md, gotchas): fuente de verdad en PostgreSQL,
/// ON CONFLICT DO NOTHING sobre índice parcial único para idempotencia.
model TicketSyncOutbox {
  idSync        String      @id @default(dbgenerated("gen_random_uuid()")) @map("id_sync") @db.Uuid
  idTicket      String      @map("id_ticket") @db.Uuid
  targetSystem  String      @default("SHAREPOINT") @map("target_system")
  operation     String
  status        String      @default("PENDING")
  payload       Json        @default("{}")
  attempts      Int         @default(0)
  lastError     String?     @map("last_error")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  processedAt   DateTime?   @map("processed_at") @db.Timestamptz(6)
  factTicket    FactTicket  @relation(fields: [idTicket], references: [idTicket], onDelete: Cascade, onUpdate: NoAction)

  @@unique([idTicket, operation], map: "uq_ticket_sync_outbox_pending_operation", where: raw("(status = ANY (ARRAY['PENDING'::text, 'PROCESSING'::text]))"))
