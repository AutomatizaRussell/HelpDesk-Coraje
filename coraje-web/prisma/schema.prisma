/// Interruptor del espejo: una sola fila (chk_espejo_sharepoint_unica). Con
/// activoDesde vacío, la salida de n8n no envía nada a SharePoint.
model EspejoSharepoint {
  id          Boolean   @id @default(true)
  activoDesde DateTime? @map("activo_desde") @db.Timestamptz(6)
  motivo      String?
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("espejo_sharepoint")
  @@schema("helpdesk")
}

/// Cambio hecho en PowerApps sobre un ticket de HelpDesk, aplicado o
/// rechazado (chk_sync_divergencia_resultado). Lo escribe solo la ingesta
/// (INSERT); coraje_runtime solo lee. La revisión (U10) la escribe solo
/// helpdesk.marcar_divergencia_revisada: chk_sync_divergencia_revision exige
/// las tres columnas juntas o ninguna.
model SyncDivergencia {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idTicket                 String       @map("id_ticket") @db.Uuid
  spId                     Int          @map("sp_id")
  campo                    String       @db.VarChar(60)
  valorHelpdesk            String?      @map("valor_helpdesk")
  valorSharepoint          String?      @map("valor_sharepoint")
  resultado                String       @db.VarChar(20)
  motivo                   String?      @db.VarChar(1000)
  modificadoEnSharepointAt DateTime?    @map("modificado_en_sharepoint_at") @db.Timestamptz(6)
  detectadoAt              DateTime     @default(now()) @map("detectado_at") @db.Timestamptz(6)
  revisadaAt               DateTime?    @map("revisada_at") @db.Timestamptz(6)
  revisadaPor              String?      @map("revisada_por") @db.Uuid
  motivoRevision           String?      @map("motivo_revision") @db.VarChar(500)
  factTicket               FactTicket   @relation(fields: [idTicket], references: [idTicket], onDelete: Restrict, onUpdate: NoAction)
  revisor                  DimPersonal? @relation(fields: [revisadaPor], references: [idPersonal], onDelete: NoAction, onUpdate: NoAction)

  @@index([idTicket, detectadoAt], map: "ix_sync_divergencia_ticket")
  @@index([detectadoAt], map: "ix_sync_divergencia_detectado")
  @@index([detectadoAt], map: "ix_sync_divergencia_sin_revisar", where: raw("(((resultado)::text = 'RECHAZADO'::text) AND (revisada_at IS NULL))"))
  @@map("sync_divergencia")
  @@schema("helpdesk")
}

