# Base de datos: web usa coraje_runtime; migrate usa coraje_migrator
DATABASE_URL=postgresql://coraje_runtime:<contraseña>@coraje_postgres:5432/coraje
DATABASE_MIGRATION_URL=postgresql://coraje_migrator:<contraseña>@coraje_postgres:5432/coraje

# Identidad de empleados (Entra ID)
ENTRA_TENANT_ID=<tenant-id>
ENTRA_CLIENT_ID=<client-id>
ENTRA_CLIENT_SECRET=<client-secret>
ENTRA_REDIRECT_URI=https://conecta.rbgct.cloud/helpdesk/api/auth/microsoft/callback

# 32 bytes en base64: sella tokens de correo, estado OIDC y códigos del portal
HELPDESK_TOKEN_ENCRYPTION_KEY=<openssl rand -base64 32>

# Espejo en PowerApps: webhook que despierta la salida de n8n
N8N_OUTBOX_KICK_URL=https://<n8n-de-helpdesk>/webhook/coraje/outbox/kick
N8N_OUTBOX_KICK_SECRET=<mismo valor que CORAJE_OUTBOX_KICK_SECRET en n8n>

# Correo desde automatizacionmedellin@ (portal y escalamiento); HTTPS obligatorio
N8N_PORTAL_MAIL_WEBHOOK_URL=https://<n8n-de-helpdesk>/webhook/helpdesk/portal/correo-v1
N8N_PORTAL_MAIL_SECRET=<mismo valor que HELPDESK_PORTAL_MAIL_SECRET en n8n>

# Escalamiento diario de avisos: mismo valor en n8n
HELPDESK_ESCALAR_AVISOS_SECRET=<openssl rand -hex 32>
