      "name": "IF - Validate HelpDesk Secret"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Valida el cuerpo que envía HelpDesk (src/server/portal/portal-mail.ts) y\n * arma el mensaje de Microsoft Graph. n8n transporta: no decide a quién ni qué\n * se envía; eso ya lo decidió PostgreSQL y la aplicación.\n *\n * saveToSentItems: false a propósito. El cuerpo lleva un código o un enlace de\n * un solo uso: una copia en Elementos enviados del buzón sería otro sitio donde\n * el secreto queda en claro.\n */\nconst body = $input.first().json.body ?? {};\n// ESCALAMIENTO (U15): el correo diario a un empleado con avisos sin atender.\nconst kinds = ['INVITACION', 'CODIGO', 'ESCALAMIENTO'];\nconst email = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nif (body.version !== 1) throw new Error('Versión de mensaje no soportada.');\nif (!kinds.includes(body.kind)) throw new Error('Tipo de correo no soportado.');\nif (typeof body.id !== 'string' || body.id.length === 0) throw new Error('Falta el id de correlación.');\nif (typeof body.to !== 'string' || !email.test(body.to)) throw new Error('Destinatario inválido.');\nif (typeof body.subject !== 'string' || body.subject.length === 0) throw new Error('Falta el asunto.');\nif (typeof body.html !== 'string' || body.html.length === 0) throw new Error('Falta el cuerpo.');\n\nreturn [\n  {\n    json: {\n      id: body.id,\n      graph: {\n        message: {\n          subject: body.subject,\n          body: { contentType: 'HTML', content: body.html },\n          toRecipients: [{ emailAddress: { address: body.to } }],\n        },\n        saveToSentItems: false,\n      },\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, -100],
