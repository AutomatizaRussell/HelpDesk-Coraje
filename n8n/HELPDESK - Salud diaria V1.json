    {
      "parameters": {
        "jsCode": "/**\n * Transporta, no compara (CLAUDE.md, fronteras): arma la lista de ítems de\n * HelpDeskBd que la base reconcilia contra staging y los tickets\n * (helpdesk.registrar_revision_salud).\n *\n * Una sola petición, sin paginar: con $top=5000 cabe la lista entera\n * (≈3.000 ítems al 28-sep-2026). Si algún día llega al tope, falla en vez\n * de reconciliar a medias: una reconciliación incompleta diría que faltan\n * ítems que sí están.\n */\nconst value = $input.first()?.json?.value;\nif (!Array.isArray(value)) {\n  throw new Error(\"SharePoint no devolvió la lista de ítems de HelpDeskBd.\");\n}\nif (value.length >= 5000) {\n  throw new Error(\"HelpDeskBd llegó a 5.000 ítems: la reconciliación de HELPDESK - Salud diaria V1 necesita paginar.\");\n}\n\nconst items = value.map((item) => ({ Id: Number(item.Id ?? item.ID), Created: item.Created }));\n\n// Viaja entre comillas de dólar con etiqueta propia; se retira la etiqueta\n// por si algún valor la contuviera.\nreturn [{ json: { items_json: JSON.stringify(items).replace(/\\$salud_items\\$/g, \"\"), items_count: items.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        100
      ],
      "id": "5b1f0c2e-7a41-4d3e-9c6a-1e2f3a4b5c64",
      "name": "Code - Build Item List"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- =================================================================\n-- Revisión diaria de salud (U10, docs/specs/observabilidad.md)\n-- =================================================================\n-- La base hace todo el trabajo: corre los chequeos, reconcilia la lista\n-- de HelpDeskBd con staging y los tickets, guarda la revisión en\n-- helpdesk.revision_salud y decide si hay algo que avisar. Solo avisa lo\n-- CRITICO que aparece o empeora respecto de la revisión anterior.\n--\n-- Corre como coraje_etl: es el único rol que ve staging.\nSELECT id_revision, notificar, mensaje\nFROM helpdesk.registrar_revision_salud(\n    $salud_items${{ $json.items_json }}$salud_items$::jsonb,\n    'N8N'\n);",
        "options": {}
      },
